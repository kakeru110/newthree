---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/url';

interface Source {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  category: string;
  dataAsOf: string;
  sources: Source[];
}

const { title, description, category, dataAsOf, sources } = Astro.props;
---

<BaseLayout title={`${title} | 統計データノート`} description={description}>
  <div class="wrap">
    <p class="eyebrow">
      <a href={withBase(`categories/${encodeURIComponent(category)}/`)}>{category}</a>
      ・{dataAsOf}
    </p>
    <h1 style="font-size: 26px; margin: 8px 0 20px;">{title}</h1>

    <slot name="chart" />

    <div class="article-body">
      <slot />
    </div>

    <div class="source-note">
      出典：{sources.map((s, i) => (
        <>
          {i > 0 && '／'}
          <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
        </>
      ))}
    </div>
  </div>
</BaseLayout>
