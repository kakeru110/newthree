---
import '../styles/global.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
}

const {
  title,
  description = '総務省などの公的統計データを、数字の裏側まで読み解いて可視化するサイト。',
  image,
  type = 'website',
  publishedDate,
  modifiedDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? withBase('og-default.png'), Astro.site);

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '統計読解室',
  url: new URL(withBase(''), Astro.site).toString(),
  description: '総務省などの公的統計データを、数字の裏側まで読み解いて可視化するサイト。',
  inLanguage: 'ja',
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="統計読解室" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ja_JP" />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {type === 'website' && (
      <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href={withBase('')}>統計読解室</a>
        <nav class="site-nav">
          <a href={withBase('')}>ホーム</a>
          <a href={withBase('categories/')}>カテゴリ</a>
          <a href={withBase('about/')}>このサイトについて</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        本サイトは総務省統計局など公的機関が公表する統計データを、政府標準利用規約2.0（CC BY 4.0相当）に基づき加工・可視化した個人プロジェクトです。各記事に出典を明記しています。
      </div>
    </footer>
  </body>
</html>
