---
interface Row {
  pref: string;
  estab: number;
  estabShare: number;
  emp: number;
  empShare: number;
  estabGrowth: number;
  empGrowth: number;
}

interface Props {
  rows: Row[];
  title?: string;
  growthNote: string;
}

const { rows, title = '都道府県別ランキング', growthNote } = Astro.props;
const chartId = `chart-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="pbc" id={chartId} data-rows={JSON.stringify(rows)}>
  <div class="pbc-controls">
    <div class="pbc-chip-group" role="group" aria-label="表示指標">
      <button class="pbc-chip" data-metric="estab" aria-pressed="true">事業所数</button>
      <button class="pbc-chip" data-metric="emp" aria-pressed="false">従業者数</button>
    </div>
    <div class="pbc-spacer"></div>
    <button class="pbc-link-btn" data-toggle-table>表で見る</button>
  </div>

  <div class="pbc-chart-title" data-title>{title}</div>

  <div class="pbc-bars" data-bars></div>
  <div class="pbc-legend"><span class="pbc-swatch"></span>{growthNote}</div>

  <div class="pbc-table-wrap" data-table-wrap hidden>
    <div class="pbc-table-scroll">
      <table class="pbc-table">
        <thead>
          <tr>
            <th>都道府県</th>
            <th>事業所数</th>
            <th>構成比</th>
            <th>従業者数</th>
            <th>構成比</th>
            <th>事業所数増減率</th>
            <th>従業者数増減率</th>
          </tr>
        </thead>
        <tbody data-table-body></tbody>
      </table>
    </div>
  </div>
</div>

<div class="pbc-tooltip" data-tooltip></div>

<style is:global>
  .pbc {
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface-1);
    padding: 20px;
    overflow-x: auto;
    margin: 20px 0;
  }
  .pbc-controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 18px; }
  .pbc-chip-group { display: inline-flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .pbc-chip {
    appearance: none; border: none; background: transparent; color: var(--text-secondary);
    font: inherit; font-size: 13px; font-weight: 600; padding: 7px 14px; cursor: pointer;
  }
  .pbc-chip[aria-pressed="true"] { background: var(--series-1-wash); color: var(--series-1); }
  .pbc-chip:not(:last-child) { border-right: 1px solid var(--border); }
  .pbc-spacer { flex: 1; }
  .pbc-link-btn {
    appearance: none; border: none; background: transparent; color: var(--text-muted);
    font: inherit; font-size: 13px; cursor: pointer; text-decoration: underline; padding: 4px 0;
  }
  .pbc-link-btn:hover { color: var(--text-primary); }
  .pbc-chart-title { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
  .pbc-bars { min-width: 560px; }
  .pbc-row { display: grid; grid-template-columns: 76px 1fr 128px; align-items: center; gap: 10px; padding: 2px 0; }
  .pbc-pref { font-size: 12.5px; color: var(--text-secondary); text-align: right; white-space: nowrap; }
  .pbc-track { position: relative; height: 24px; border-bottom: 1px solid var(--gridline); }
  .pbc-bar { position: absolute; left: 0; top: 2px; height: 20px; background: var(--series-1); border-radius: 4px; min-width: 2px; }
  .pbc-bar:hover { filter: brightness(1.08); cursor: pointer; }
  .pbc-valcell { display: flex; align-items: baseline; gap: 8px; font-size: 12.5px; white-space: nowrap; }
  .pbc-val { font-variant-numeric: tabular-nums; color: var(--text-primary); font-weight: 600; }
  .pbc-delta { font-variant-numeric: tabular-nums; font-size: 11.5px; }
  .pbc-delta.good { color: var(--delta-good); }
  .pbc-delta.bad { color: var(--delta-bad); }
  .pbc-legend { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-muted); margin-top: 16px; }
  .pbc-swatch { width: 10px; height: 10px; border-radius: 2px; background: var(--series-1); display: inline-block; }
  .pbc-table { width: 100%; border-collapse: collapse; font-size: 12.5px; min-width: 560px; }
  .pbc-table th, .pbc-table td { padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--gridline); }
  .pbc-table th:first-child, .pbc-table td:first-child { text-align: left; }
  .pbc-table th { color: var(--text-muted); font-weight: 600; }
  .pbc-table td { font-variant-numeric: tabular-nums; color: var(--text-secondary); }
  .pbc-table td:first-child { color: var(--text-primary); }
  .pbc-table-scroll { max-height: 480px; overflow-y: auto; }

  .pbc-tooltip {
    position: fixed; pointer-events: none; z-index: 10;
    background: var(--text-primary); color: var(--page-plane);
    font-size: 12px; line-height: 1.5; padding: 8px 10px; border-radius: 6px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.2);
    opacity: 0; transform: translateY(4px); transition: opacity 0.1s ease;
    max-width: 220px;
  }
  .pbc-tooltip.show { opacity: 1; }
  .pbc-tooltip b { font-weight: 700; }
  .pbc-tooltip .tt-row { display: flex; justify-content: space-between; gap: 12px; }
</style>

<script>
  function fmt(n: number) { return n.toLocaleString('ja-JP'); }
  function fmtPct(n: number) { const s = n > 0 ? '+' : (n === 0 ? '±' : ''); return s + n.toFixed(1) + '%'; }

  document.querySelectorAll<HTMLElement>('.pbc').forEach((root) => {
    const rows = JSON.parse(root.dataset.rows || '[]');
    const barsEl = root.querySelector<HTMLElement>('[data-bars]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-title]')!;
    const baseTitle = titleEl.textContent || '';
    const tooltip = document.querySelector<HTMLElement>('[data-tooltip]')!;
    let metric: 'estab' | 'emp' = 'estab';

    function render() {
      const key = metric === 'estab' ? 'estab' : 'emp';
      const shareKey = metric === 'estab' ? 'estabShare' : 'empShare';
      const growthKey = metric === 'estab' ? 'estabGrowth' : 'empGrowth';
      const otherKey = metric === 'estab' ? 'emp' : 'estab';
      const otherLabel = metric === 'estab' ? '従業者数' : '事業所数';
      const unit = metric === 'estab' ? '事業所' : '人';

      titleEl.textContent = baseTitle + (metric === 'estab' ? '（事業所数）' : '（従業者数）');

      const sorted = [...rows].sort((a, b) => b[key] - a[key]);
      const max = sorted[0][key];

      barsEl.innerHTML = '';
      sorted.forEach((row) => {
        const value = row[key];
        const growth = row[growthKey];
        const pct = (value / max) * 100;

        const rowEl = document.createElement('div');
        rowEl.className = 'pbc-row';

        const prefEl = document.createElement('div');
        prefEl.className = 'pbc-pref';
        prefEl.textContent = row.pref;

        const trackEl = document.createElement('div');
        trackEl.className = 'pbc-track';
        const barEl = document.createElement('div');
        barEl.className = 'pbc-bar';
        barEl.style.width = pct + '%';
        trackEl.appendChild(barEl);

        const valcellEl = document.createElement('div');
        valcellEl.className = 'pbc-valcell';
        const valEl = document.createElement('span');
        valEl.className = 'pbc-val';
        valEl.textContent = fmt(value);
        const deltaEl = document.createElement('span');
        deltaEl.className = 'pbc-delta ' + (growth > 0 ? 'good' : growth < 0 ? 'bad' : '');
        deltaEl.textContent = fmtPct(growth);
        valcellEl.appendChild(valEl);
        valcellEl.appendChild(deltaEl);

        rowEl.appendChild(prefEl);
        rowEl.appendChild(trackEl);
        rowEl.appendChild(valcellEl);
        barsEl.appendChild(rowEl);

        function showTip(e: MouseEvent) {
          tooltip.innerHTML =
            '<b>' + row.pref + '</b><br>' +
            '<div class="tt-row"><span>' + (metric === 'estab' ? '事業所数' : '従業者数') + '</span><span>' + fmt(value) + unit + '（' + row[shareKey] + '%）</span></div>' +
            '<div class="tt-row"><span>' + otherLabel + '</span><span>' + fmt(row[otherKey]) + (metric === 'estab' ? '人' : '事業所') + '</span></div>' +
            '<div class="tt-row"><span>2012年比増減</span><span>' + fmtPct(growth) + '</span></div>';
          tooltip.classList.add('show');
          moveTip(e);
        }
        function moveTip(e: MouseEvent) {
          tooltip.style.left = (e.clientX + 14) + 'px';
          tooltip.style.top = (e.clientY + 14) + 'px';
        }
        function hideTip() { tooltip.classList.remove('show'); }

        barEl.addEventListener('mousemove', showTip);
        barEl.addEventListener('mouseenter', showTip);
        barEl.addEventListener('mouseleave', hideTip);
        trackEl.addEventListener('mousemove', moveTip);
      });
    }

    root.querySelectorAll<HTMLButtonElement>('.pbc-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        metric = chip.dataset.metric as 'estab' | 'emp';
        root.querySelectorAll('.pbc-chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        render();
      });
    });

    const tableBody = root.querySelector<HTMLElement>('[data-table-body]')!;
    [...rows].sort((a, b) => b.estab - a.estab).forEach((row) => {
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + row.pref + '</td>' +
        '<td>' + fmt(row.estab) + '</td>' +
        '<td>' + row.estabShare.toFixed(1) + '%</td>' +
        '<td>' + fmt(row.emp) + '</td>' +
        '<td>' + row.empShare.toFixed(1) + '%</td>' +
        '<td>' + fmtPct(row.estabGrowth) + '</td>' +
        '<td>' + fmtPct(row.empGrowth) + '</td>';
      tableBody.appendChild(tr);
    });

    const barsWrap = root.querySelector<HTMLElement>('[data-bars]')!;
    const legend = root.querySelector<HTMLElement>('.pbc-legend')!;
    const tableWrap = root.querySelector<HTMLElement>('[data-table-wrap]')!;
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-toggle-table]')!;
    let showingTable = false;
    toggleBtn.addEventListener('click', () => {
      showingTable = !showingTable;
      barsWrap.hidden = showingTable;
      legend.hidden = showingTable;
      tableWrap.hidden = !showingTable;
      toggleBtn.textContent = showingTable ? 'チャートで見る' : '表で見る';
    });

    render();
  });
</script>
