---
interface Series {
  name: string;
  values: (number | null)[];
  colorSlot?: 1 | 2 | 3;
  dash?: boolean;
}

interface Props {
  categories: string[];
  series: Series[];
  title: string;
  unit: string;
  tickEvery?: number;
}

const { categories, series, title, unit, tickEvery = 1 } = Astro.props;
const chartId = `lc-${Math.random().toString(36).slice(2, 9)}`;

const W = 640;
const H = 300;
const PAD_L = 46;
const PAD_R = 16;
const PAD_T = 16;
const PAD_B = 32;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const allValues = series.flatMap((s) => s.values).filter((v): v is number => v !== null);
const maxV = Math.max(...allValues);
const minV = Math.min(0, Math.min(...allValues));
const niceMax = maxV * 1.12;

function xPos(i: number) {
  return PAD_L + (categories.length === 1 ? plotW / 2 : (plotW * i) / (categories.length - 1));
}
function yPos(v: number) {
  return PAD_T + plotH - ((v - minV) / (niceMax - minV)) * plotH;
}

const colorVar = (slot: number | undefined) => (slot === 2 ? '--series-2' : slot === 3 ? '--series-3' : '--series-1');

const paths = series.map((s) => {
  const pts = s.values
    .map((v, i) => (v === null ? null : `${xPos(i)},${yPos(v)}`))
    .filter((p): p is string => p !== null);
  return { name: s.name, d: 'M ' + pts.join(' L '), colorVar: colorVar(s.colorSlot), dash: s.dash };
});

const yTicks = 4;
const yTickValues = Array.from({ length: yTicks + 1 }, (_, i) => (niceMax / yTicks) * i);
---

<div class="lc" id={chartId} data-categories={JSON.stringify(categories)} data-series={JSON.stringify(series)} data-unit={unit}>
  <div class="lc-title">{title}</div>

  {series.length > 1 && (
    <div class="lc-legend">
      {series.map((s) => (
        <span class="lc-legend-item">
          <span
            class="lc-swatch"
            style={`border-top-color:var(${colorVar(s.colorSlot)});border-top-style:${s.dash ? 'dashed' : 'solid'}`}
          ></span>
          {s.name}
        </span>
      ))}
    </div>
  )}

  <div class="lc-svgwrap">
    <svg viewBox={`0 0 ${W} ${H}`} class="lc-svg" data-plot preserveAspectRatio="xMidYMid meet">
      {yTickValues.map((v) => (
        <g>
          <line x1={PAD_L} x2={W - PAD_R} y1={yPos(v)} y2={yPos(v)} class="lc-grid" />
          <text x={PAD_L - 8} y={yPos(v)} class="lc-axis-label" text-anchor="end" dominant-baseline="middle">
            {Math.round(v).toLocaleString('ja-JP')}
          </text>
        </g>
      ))}

      {categories.map((c, i) => (
        i % tickEvery === 0 && (
          <text x={xPos(i)} y={H - 8} class="lc-axis-label" text-anchor="middle">{c}</text>
        )
      ))}

      {paths.map((p) => (
        <path
          d={p.d}
          fill="none"
          stroke={`var(${p.colorVar})`}
          stroke-width="2"
          stroke-linejoin="round"
          stroke-linecap="round"
          stroke-dasharray={p.dash ? '7 4' : undefined}
        />
      ))}

      {series.map((s) => {
        const lastIdx = s.values.map((v, i) => (v !== null ? i : -1)).filter((i) => i >= 0).pop();
        if (lastIdx === undefined) return null;
        const v = s.values[lastIdx]!;
        return (
          <g>
            <circle cx={xPos(lastIdx)} cy={yPos(v)} r="4" fill={`var(${colorVar(s.colorSlot)})`} stroke="var(--surface-1)" stroke-width="2" />
          </g>
        );
      })}

      <line class="lc-crosshair" data-crosshair x1="0" x2="0" y1={PAD_T} y2={PAD_T + plotH} />
    </svg>
    <div class="lc-tooltip" data-tooltip></div>
  </div>
</div>

<style is:global>
  .lc {
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface-1);
    padding: 20px;
    margin: 20px 0;
  }
  .lc-title { font-size: 13px; color: var(--text-muted); margin-bottom: 10px; }
  .lc-legend { display: flex; gap: 16px; margin-bottom: 10px; }
  .lc-legend-item { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-secondary); }
  .lc-swatch { width: 16px; height: 0; border-top-width: 2.5px; border-top-style: solid; display: inline-block; }
  .lc-svgwrap { position: relative; }
  .lc-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .lc-grid { stroke: var(--gridline); stroke-width: 1; }
  .lc-axis-label { fill: var(--text-muted); font-size: 9.5px; font-family: system-ui, sans-serif; }
  .lc-crosshair { stroke: var(--baseline); stroke-width: 1; opacity: 0; pointer-events: none; }
  .lc-tooltip {
    position: fixed; pointer-events: none; z-index: 10;
    background: var(--text-primary); color: var(--page-plane);
    font-size: 12px; line-height: 1.5; padding: 8px 10px; border-radius: 6px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.2);
    opacity: 0; transition: opacity 0.1s ease;
    max-width: 220px;
  }
  .lc-tooltip.show { opacity: 1; }
  .lc-tooltip b { font-weight: 700; }
  .lc-tooltip .tt-row { display: flex; justify-content: space-between; gap: 12px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.lc').forEach((root) => {
    const categories: string[] = JSON.parse(root.dataset.categories || '[]');
    const series: { name: string; values: (number | null)[] }[] = JSON.parse(root.dataset.series || '[]');
    const unit = root.dataset.unit || '';
    const svg = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const crosshair = root.querySelector<SVGLineElement>('[data-crosshair]')!;
    const tooltip = root.querySelector<HTMLElement>('[data-tooltip]')!;

    const W = 640, PAD_L = 46, PAD_R = 16;
    const plotW = W - PAD_L - PAD_R;

    function nearestIndex(clientX: number) {
      const rect = svg.getBoundingClientRect();
      const scale = W / rect.width;
      const svgX = (clientX - rect.left) * scale;
      const ratio = (svgX - PAD_L) / plotW;
      const idx = Math.round(ratio * (categories.length - 1));
      return Math.max(0, Math.min(categories.length - 1, idx));
    }

    function xPos(i: number) {
      return PAD_L + (categories.length === 1 ? plotW / 2 : (plotW * i) / (categories.length - 1));
    }

    function show(e: MouseEvent) {
      const idx = nearestIndex(e.clientX);
      const cx = xPos(idx);
      crosshair.setAttribute('x1', String(cx));
      crosshair.setAttribute('x2', String(cx));
      crosshair.style.opacity = '1';

      let html = '<b>' + categories[idx] + '</b><br>';
      for (const s of series) {
        const v = s.values[idx];
        html += '<div class="tt-row"><span>' + s.name + '</span><span>' + (v === null ? '—' : v.toLocaleString('ja-JP') + unit) + '</span></div>';
      }
      tooltip.innerHTML = html;
      tooltip.classList.add('show');
      tooltip.style.left = (e.clientX + 14) + 'px';
      tooltip.style.top = (e.clientY + 14) + 'px';
    }
    function hide() {
      crosshair.style.opacity = '0';
      tooltip.classList.remove('show');
    }

    svg.addEventListener('mousemove', show);
    svg.addEventListener('mouseleave', hide);
  });
</script>
